<?xml version="1.0" encoding="utf-8"?>
<!--
  崩坏：星穹铁道 · 风格化图标（原创绘制，不使用任何游戏厂商素材）

  构图：一个不闭合的轨道环 + 一条斜向穿过它的星轨 + 一颗亮点。
  与另外两个游戏靠「斜向构图 + 紫色」区分（前两个都是左右对称的）。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="96dp"
    android:height="96dp"
    android:viewportWidth="96"
    android:viewportHeight="96">

    <path
        android:pathData="M0,22 A22,22 0 0 1 22,0 L74,0 A22,22 0 0 1 96,22 L96,74 A22,22 0 0 1 74,96 L22,96 A22,22 0 0 1 0,74 Z"
        android:fillColor="#FF7B5CFF" />

    <!-- 轨道环（右上留缺口） -->
    <path
        android:pathData="M68,33 A24,24 0 1 1 40,26"
        android:strokeColor="#FFEDE8FF"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- 星轨 -->
    <path
        android:pathData="M26,72 C40,62 56,44 72,26"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- 亮点 + 光晕 -->
    <path
        android:pathData="M62.5,26 A9.5,9.5 0 1 1 81.5,26 A9.5,9.5 0 1 1 62.5,26 Z"
        android:fillColor="#38FFFFFF" />
    <path
        android:pathData="M66.5,26 A5.5,5.5 0 1 1 77.5,26 A5.5,5.5 0 1 1 66.5,26 Z"
        android:fillColor="#FFFFFFFF" />
</vector>
